# Cấu hình News Search Engine (news_search/config.py đọc qua biến môi trường).
# Sao chép thành .env và chỉnh theo môi trường. MẶC ĐỊNH chạy offline hoàn toàn
# (không cần dịch vụ ngoài) để dev/test/demo.

# --- Lựa chọn backend ---
LEXICAL_BACKEND=local          # local | opensearch  (production: opensearch)
VECTOR_BACKEND=local           # local | milvus       (production: milvus + HNSW)
EMBEDDER=hash                  # hash (offline) | bge (BGE-m3 local) | openai (text-embedding-3-large)
RERANKER=none                  # none | bge (BAAI/bge-reranker-v2-m3, cần FlagEmbedding)

# --- Embedding ---
EMBEDDING_DIM=256              # dim của HashingEmbedder local (chỉ áp cho EMBEDDER=hash)
# OPENAI_API_KEY=sk-...        # bắt buộc khi EMBEDDER=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# BGE-m3 local (EMBEDDER=bge) — cần FlagEmbedding hoặc sentence-transformers
BGE_MODEL=BAAI/bge-m3
BGE_DIM=1024
BGE_DEVICE=                    # "" tự chọn | cpu | cuda | cuda:0

# --- Milvus + HNSW (VECTOR_BACKEND=milvus) ---
MILVUS_URI=http://localhost:19530   # hoặc ./milvus.db cho Milvus Lite
# MILVUS_TOKEN=
MILVUS_COLLECTION=news_articles
MILVUS_METRIC=COSINE                # COSINE | IP | L2
HNSW_M=16                           # số cạnh mỗi node HNSW
HNSW_EF_CONSTRUCTION=200            # độ rộng tìm kiếm lúc build (chất lượng đồ thị)
HNSW_EF_SEARCH=64                   # độ rộng tìm kiếm lúc query (recall/tốc độ)

# --- Retrieval / fusion ---
CANDIDATES_K=100               # số ứng viên lấy từ mỗi nhánh (lexical/vector)
RRF_K=60                       # hằng số Reciprocal Rank Fusion

# --- Time-decay / QDF (F-13) ---
HALF_LIFE_DAYS=30              # half-life cho truy vấn THƯỜNG (decay nhẹ)
FRESH_HALF_LIFE_DAYS=2         # half-life cho truy vấn TIN NÓNG (recency áp đảo)
DECAY_FLOOR=0.5                # hệ số suy giảm tối thiểu (giới hạn mức phạt bài cũ)

# --- Rerank ---
RERANK_TOP_N=50               # số bài đưa vào rerank tinh

# --- Dedup / đa dạng hóa (F-07, F-14) ---
DEDUP_THRESHOLD=0.7           # ngưỡng Jaccard gom cụm gần trùng
DEDUP_NUM_PERM=128            # số hàm băm MinHash
DEDUP_SHINGLE_SIZE=3          # kích thước word-shingle
MAX_PER_CLUSTER=1             # số bài tối đa mỗi cụm sự kiện trong kết quả
MMR_LAMBDA=0.7               # cân bằng liên quan/đa dạng của MMR
MMR_POOL=30                  # kích thước pool trước khi MMR chọn top_k

# --- Snippet (F-15) ---
SNIPPET_MAX_LEN=200          # độ dài tối đa đoạn trích (ký tự)

# --- HuggingFace ---
HF_TOKEN=hf_

# --- Nguồn dữ liệu ---
SOURCE=postgres               # sample (file JSON offline) | postgres (CMS thật)
ARTICLE_BASE_URL=             # tiền tố dựng URL từ slug (rỗng -> "/{slug}")
INGEST_BATCH_SIZE=500

# --- Postgres CMS ---
PG_HOST=0.0.0.0
PG_PORT=6432
PG_USER=user
PG_PASS=password
PG_DB=db_name
PG_SCHEMA=schema_name

# ============================================================================
# TÍNH NĂNG PHỤ — bật/tắt có trách nhiệm (mặc định TẮT/an toàn, degrade khi thiếu
# phụ thuộc). Bật từng cái khi cần; không bật vẫn chạy đầy đủ tính năng lõi.
# ============================================================================

# (GĐ1) Log click/dwell — nền tảng đánh giá & học xếp hạng
FEEDBACK_ENABLED=false        # true để bật
FEEDBACK_BACKEND=jsonl        # jsonl (bền vững) | redis
# FEEDBACK_PATH=data/feedback/events.jsonl

# (GĐ3) Query understanding
QU_SPELLCORRECT=false         # sửa lỗi chính tả (Norvig trên vocab corpus)
QU_EXPANSION=false            # mở rộng đồng nghĩa/alias
QU_LLM_REWRITE=false          # viết lại bằng LLM (cần OPENAI_API_KEY)
QU_MAX_EDIT_DISTANCE=2
# SYNONYMS_PATH=               # file JSON alias tùy chọn

# (GĐ5) Cache truy vấn nóng
CACHE_ENABLED=false           # true để bật
CACHE_BACKEND=memory          # memory | redis
CACHE_TTL_SECONDS=60
CACHE_MAX_SIZE=1000
CACHE_BYPASS_FRESH=true       # không cache truy vấn tin nóng

# (GĐ5) Metrics / dashboard / alert
METRICS_ENABLED=true          # /metrics (Prometheus) — nhẹ, an toàn -> mặc định BẬT
DASHBOARD_ENABLED=true        # /dashboard (HTML)
ALERT_P95_MS=500
ALERT_ERROR_RATE=0.05
ALERT_ZERO_RESULT_RATE=0.3
# ALERT_WEBHOOK_URL=

# (GĐ5) A/B & interleaving
EXPERIMENT_ENABLED=false      # gán biến thể A/B (header X-Variant) + log

# Admin (blue-green reindex qua POST /admin/reindex) — rỗng => route admin TẮT
ADMIN_TOKEN=

# Redis dùng chung cho cache/feedback backend
REDIS_URL=redis://localhost:6379/0

# OpenSearch (LEXICAL_BACKEND=opensearch)
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=news_articles
# OPENSEARCH_USER=
# OPENSEARCH_PASSWORD=